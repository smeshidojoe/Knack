# --- Секреты ---------------------------------------------------------------- #
# Токен Figma и всё, что похоже на ключи. В репозиторий не попадает никогда.
.env
.env.*
!.env.example
*.key
*.pem

# --- Python ----------------------------------------------------------------- #
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
pip-wheel-metadata/

# Окружения
.venv/
venv/
env/
ENV/

# Кеши инструментов
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
htmlcov/
.coverage
.coverage.*

# --- Сборка ----------------------------------------------------------------- #
# PyInstaller: build/ и dist/ пересобираются, .spec — нет, его держим в репозитории.
build/
dist/
*.manifest

# Inno Setup
installer_output/
Output/

# Папка самообновления создаётся рядом с exe, в разработке — в корне проекта.
_update/

# --- Данные программы -------------------------------------------------------- #
# Полка, история буфера, заметки и модели переводчика лежат в %APPDATA%\Knack и
# сюда попасть не должны, но на случай запуска с переносными путями:
knack.log
*.log
config.json

# --- Редакторы и ОС ---------------------------------------------------------- #
.vscode/
.idea/
*.code-workspace
*.swp
*~
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# Заметки по ходу разработки — не для пользователей репозитория.
README.dev.md

# --- Черновики --------------------------------------------------------------- #
scratch/
tmp/
*.bak
*.orig
